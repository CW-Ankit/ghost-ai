    {
      "name": "04 Canvas Storage",
      "item": [
        {
          "name": "Save Canvas Snapshot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Canvas saved (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.blobUrl).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"persistToConvex\": true,\n  \"nodes\": [\n    {\n      \"id\": \"api-gw\",\n      \"type\": \"canvasNode\",\n      \"position\": { \"x\": 100, \"y\": 100 },\n      \"data\": { \"label\": \"API Gateway\", \"shape\": \"diamond\", \"color\": \"blue\" }\n    },\n    {\n      \"id\": \"core-db\",\n      \"type\": \"canvasNode\",\n      \"position\": { \"x\": 400, \"y\": 100 },\n      \"data\": { \"label\": \"Postgres DB\", \"shape\": \"cylinder\", \"color\": \"green\" }\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"e1\",\n      \"source\": \"api-gw\",\n      \"target\": \"core-db\",\n      \"sourceHandle\": \"right-source\",\n      \"targetHandle\": \"left-target\",\n      \"data\": { \"label\": \"SQL\" }\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/canvas/save"
          }
        },
        {
          "name": "Load Saved Canvas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Canvas loaded (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.canvas.nodes.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/canvas/save?projectId={{projectId}}"
          }
        }
      ]
    },
    {
      "name": "05 AI Workflows & Task Runs",
