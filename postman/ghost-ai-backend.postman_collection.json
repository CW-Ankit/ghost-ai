  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 or 503 with service flags', function () {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('services');",
                  "  pm.expect(json.services).to.have.property('convexConfigured');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "02 Projects",
      "item": [
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Project created (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.projectId).to.be.a('string');",
                  "  pm.expect(json.roomId).to.be.a('string');",
                  "  pm.collectionVariables.set('projectId', json.projectId);",
                  "  pm.collectionVariables.set('roomId', json.roomId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Architecture Demo\",\n  \"description\": \"Created from Postman backend test suite\"\n}"
            },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "List Projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns owned and shared arrays', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('owned');",
                  "  pm.expect(json).to.have.property('shared');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "Get Project By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns project with role', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json._id).to.eql(pm.collectionVariables.get('projectId'));",
                  "  pm.expect(json.role).to.eql('owner');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          }
        },
        {
          "name": "Update Project (Rename, Status, Tags, Public Access)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Project updated (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Architecture Demo v2\",\n  \"status\": \"REVIEW\",\n  \"tags\": [\"microservices\", \"postman\"],\n  \"publicAccess\": \"VIEW_ONLY\"\n}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          }
        }
      ]
    },
