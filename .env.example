# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/editor
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/editor

# Convex Backend (also set CLERK_FRONTEND_API_URL in Convex env)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Liveblocks Collaboration
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=

# Vercel Blob (Artifact Storage)
BLOB_READ_WRITE_TOKEN=

# Mistral AI (Set in Convex cloud env: npx convex env set MISTRAL_API_KEY <key>)
MISTRAL_API_KEY=

# Shared internal secret for Convex -> /api/specs/upload in production
# (Also set in Convex cloud env: npx convex env set CONVEX_INTERNAL_SECRET <secret>)
CONVEX_INTERNAL_SECRET=
